#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/app_config"
require_relative "../config/logger"
require "active_support/core_ext/string/inflections"

migration_name = ARGV[0]

if migration_name.nil? || migration_name.strip.empty?
  BattleEngine.logger.error("Usage: ruby scripts/db_create_migration <MigrationName>")
  BattleEngine.logger.error("Example: ruby scripts/db_create_migration create_users")
  exit 1
end

# Normalize name: snake_case for filename, CamelCase for class name
snake_name = migration_name.underscore
class_name = migration_name.camelize

# YYYYMMDDHHMMSS timestamp prefix
timestamp = Time.now.utc.strftime("%Y%m%d%H%M%S")
filename = "#{timestamp}_#{snake_name}.rb"
migrate_dir = File.expand_path("../db/migrate", __dir__)

# Ensure directory exists
Dir.mkdir(migrate_dir) unless Dir.exist?(migrate_dir)

filepath = File.join(migrate_dir, filename)

template = <<~RUBY
  # frozen_string_literal: true

  class #{class_name} < ActiveRecord::Migration[7.1]
    def change
    end
  end
RUBY

File.write(filepath, template)
BattleEngine.logger.info("[DB] Created migration file: db/migrate/#{filename}")
